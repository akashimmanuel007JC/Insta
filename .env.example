# Private Studio authentication (required by `npm run studio`)
ADMIN_PASSWORD=replace-with-a-strong-password
AUTH_SECRET=replace-with-at-least-32-random-characters

# Server / public image URL
PORT=3000
PUBLIC_URL=https://your-studio-host.example
AUTO_PUBLISH_ENABLED=true

# News sources
GUARDIAN_KEY=replace-me
GNEWS_KEY=replace-me
NASA_KEY=replace-me
WIKIMEDIA_USER_AGENT=NewsCarousel/1.0 (contact@example.com)

# Azure OpenAI text
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=replace-me
AZURE_OPENAI_DEPLOYMENT=replace-me

# Azure OpenAI image
AZURE_OPENAI_IMAGE_API_KEY_1=replace-me
AZURE_OPENAI_IMAGE_ENDPOINT_1=https://your-image-resource.openai.azure.com
AZURE_OPENAI_IMAGE_API_VERSION_1=replace-me
AZURE_OPENAI_IMAGE_DEPLOYMENT=replace-me

# Instagram publishing
IG_USER_ID=replace-me
IG_ACCESS_TOKEN=replace-me

# Optional notifications / token maintenance
TELEGRAM_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me
GH_SECRETS_TOKEN=replace-me
